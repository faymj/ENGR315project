batching_ACPWRT = []
Perday_ACPWRT = []
dayswithpower = []
startcounting = ""

#calculating the total energy per day
for x in range(len(all_ACPWRT)):
    if all_ACPWRT[x] > 0:
        startcounting = True
        #kw*300 seconds = kJ
        batching_ACPWRT.append(all_ACPWRT[x]*300)
        #print('above 0')
    if startcounting == True:
        if all_ACPWRT[x] == 0:
            Perday_ACPWRT.append(sum(batching_ACPWRT))
            dayswithpower.append(all_DAY[x])
            batching_ACPWRT = []
            startcounting = False
            #print('finished')

#print((Perday_ACPWRT))
#print((dayswithpower))

#create graph of the data
print('generating graph')
plt.bar(dayswithpower, Perday_ACPWRT)
plt.title('Solar Energy generated over longterm')
plt.xlabel('Day (0 marks Jan 1 2022)')
plt.ylabel('Energy per day (KJ)')
plt.legend()
plt.grid(True)

timeend = time.perf_counter()
print("took " + str(timeend - timestart) + " seconds to run.")

plt.show()


