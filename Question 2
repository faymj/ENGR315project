import numpy as np
import sys
import time
import matplotlib.pyplot as plt

timestart = time.perf_counter()

def statement(statement):
    print("------------------------------------")
    print(str(statement))
    print("------------------------------------")
    return

statement("start")
#finished basic initialization

#place filepaths here
file_path = "FPV_Oakville_CA_Inverter1_data.csv"
try:
    fin = open(file_path)
except FileNotFoundError:
    print('File ', file_path, ' not found. Exiting!')
    sys.exit(-1)

# get rid of the headers
fin.readline()

# while not done parsing file
done = False

#setup lists
all_ACPWRT = []
all_DAY = []
all_HOUR = []

done = False

# loop and read file
while not done:
    line = fin.readline()

    if line == '':
        done = True
        continue

    # prepare to pull out the parts I want
    (POINT, DAY, HOUR, ACPWRT, DCVOLT, RESIST, TEMPER, VL1TO2, VL2TO3, VL3TO1, ACCUR1, ACCUR2, ACCUR3, ACVLT1, ACVLT2, ACVLT3, ACFRQ1, ACFRQ2, ACFRQ3, APPWR1, APPWR2, APPWR3, ACPWR1, ACPWR2, ACPWR3, REPWR1, REPWR2, REPWR3) = line.rstrip().split(",")

    # clean up the data
    if ACPWRT == '_':
        ACPWRT = int(0)
    if ACPWRT == '32767.0':
        ACPWRT = int(0)
    if ACPWRT == '0.0':
        ACPWRT = int(0)

    #collect parts into our lists
    all_ACPWRT.append(float(ACPWRT))
    all_DAY.append(((int(DAY[0:4]) - 2022) * 365 ) + int(DAY[4:]))
    all_HOUR.append(HOUR)

    if all_DAY[-1] > 800:
        done = True


