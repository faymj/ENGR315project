import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import time

tm1 = time.perf_counter()

## Load the dataset
print('Loading dataset...')
df = pd.read_csv('FPV_Oakville_CA_Inverter1_data.csv')

## Clean the data
## 32767 is an error code, \
## so we need to replace it with 0 so our averages aren't ruined
df['ACPWRT_clean'] = np.where(df['ACPWRT'] == 32767, 0, df['ACPWRT'])

#Calculate Metrics
daily_data = df.groupby('DAY')['ACPWRT_clean'].agg(
    Daily_Peak = 'max',
    Daily_Average='mean'
).reset_index()

#Filter out days where the panel produced 0 kW
valid_days = daily_data[daily_data['Daily_Peak'] > 10]

#Calculate final metrics for printout
max_peak_ever = valid_days['Daily_Peak'].max()
overall_avg_peak = valid_days['Daily_Peak'].mean()
overall_avg_24h = valid_days['Daily_Average'].mean()

#Print the metrics
print("")
print("------------------------------------")
print("SOLAR PANEL OUTPUT METRICS (24-Hour)")
print("------------------------------------")
print(f"Absolute Maximum Peak Recorded: {max_peak_ever:.2f} kW")
print(f"Average Dealy Peak Output: {overall_avg_peak:.2f} kW")
print(f"Average 24-Hour Power Output: {overall_avg_24h:.2f} kW")
print("")

#Create the Histogram
print("Generating Histogram...")
plt.figure(figsize=(10, 6))

#Plot the Daily Peaks
plt.hist(valid_days['Daily_Peak'], bins=25, alpha=0.6, color='orange',
         label='Daily Peak (kW)', edgecolor='black')

#Plot the 24-Hour Averages
plt.hist(valid_days['Daily_Average'], bins=25, alpha=0.6, color='blue',
         label='24h Average (kW)', edgecolor='black')

#Apply labels, titles, and units
plt.title('Distribution of Daily Peak vs. 24-Hour Average Solar Output', fontsize=14)
plt.xlabel('Power Output (kW)', fontsize=12)
plt.ylabel('Number of Days (Frequency)', fontsize=12)

#Add a legend and a gridto make it easy to read
plt.legend()
plt.grid(axis='y', linestyle='--', alpha=0.7)

